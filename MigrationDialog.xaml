<Window x:Class="GTNHMigrator.MigrationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GTNH Migrator" Width="540" SizeToContent="Height" MinHeight="250" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource PaperBrush}">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock x:Name="KindText" Text="GTNH // NOTICE" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}"/><TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="28" Foreground="{StaticResource InkBrush}" Margin="0,5,0,0"/></StackPanel>
<Border Grid.Row="1" Style="{StaticResource MinecraftPanel}" Padding="18"><TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"/></Border>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="ConfirmButton" Content="CONTINUE" Background="{StaticResource SuccessBrush}" Click="Confirm_Click"/><Button x:Name="CancelButton" Content="CANCEL" Background="{StaticResource PanelRaisedBrush}" Click="Cancel_Click"/></StackPanel>
</Grid></Window>