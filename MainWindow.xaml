<Window x:Class="GTNHMigrator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GTNH Migrator // Instance Transfer" Width="1180" Height="780" MinWidth="900" MinHeight="650" Background="{StaticResource PaperBrush}" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
<Window.Resources><Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style><Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}"/></Style></Window.Resources>
<Grid>
<Grid x:Name="ModeSelectionView" Margin="30" Visibility="Visible">
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
<StackPanel Margin="0,0,0,10" HorizontalAlignment="Center"><TextBlock Text="GTNH MIGRATOR" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="SELECT MIGRATION TYPE" FontFamily="{StaticResource DisplayFont}" FontSize="40" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/></StackPanel>
<TextBlock Text="Client instances (Prism Launcher / .minecraft) and dedicated server instances use different whitelists and tweak catalogs. Choose the setup that matches your migration." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" MaxWidth="640" HorizontalAlignment="Center"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
<Border Width="260" Height="260" Style="{StaticResource MinecraftPanel}" Padding="24" Margin="0,0,10,0" Cursor="Hand" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="1" AutomationProperties.Name="Client migration" AutomationProperties.HelpText="Migrate a Prism or MultiMC client instance." MouseLeftButtonUp="Client_Click" KeyDown="ModeCard_KeyDown"><StackPanel VerticalAlignment="Center"><TextBlock Text="CLIENT" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock Text="Modpack Instance" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource InkBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/><TextBlock Text="Prism/MultiMC instance played locally, including LAN/integrated hosting. Carries over saves, options, and client-only tweaks." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Width="260" Height="260" Style="{StaticResource MinecraftPanel}" Padding="24" Margin="10,0,10,0" Cursor="Hand" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="2" AutomationProperties.Name="Server migration" AutomationProperties.HelpText="Migrate a dedicated server instance." MouseLeftButtonUp="Server_Click" KeyDown="ModeCard_KeyDown"><StackPanel VerticalAlignment="Center"><TextBlock Text="SERVER" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock Text="Dedicated Server" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource InkBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/><TextBlock Text="Headless server instance. Also carries over ops, whitelist, bans, and server-only tweaks." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Width="260" Height="260" Style="{StaticResource MinecraftPanel}" Padding="24" Margin="10,0,0,0" Cursor="Hand" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="3" AutomationProperties.Name="Client and server migration" AutomationProperties.HelpText="Migrate a client instance and a dedicated server instance." MouseLeftButtonUp="Dual_Click" KeyDown="ModeCard_KeyDown"><StackPanel VerticalAlignment="Center"><TextBlock Text="CLIENT + SERVER" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock Text="Separate Instances" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource InkBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/><TextBlock Text="A Prism client instance and a separate dedicated server folder. Migrates both, one after the other." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel>
</StackPanel>
</Grid>
<Grid x:Name="MainContentGrid" Margin="30" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="GTNH MIGRATOR" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock x:Name="TitleText" Text="INSTANCE TRANSFER" FontFamily="{StaticResource DisplayFont}" FontSize="40" Foreground="{StaticResource InkBrush}"/><TextBlock x:Name="ModeSubtitleText" Text="CLIENT DATA" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Grid.Column="1" Content="CHANGE MIGRATION TYPE" VerticalAlignment="Bottom" Background="{StaticResource PanelRaisedBrush}" Click="ChangeMode_Click"/></Grid>
<Grid Grid.Row="1" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Select profiles, scan the whitelist, then review common changes." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RefreshProfilesButton" Content="REFRESH PROFILES" Click="RefreshProfiles_Click"/><Button Content="SCAN WHITELIST" Background="{StaticResource AccentBrush}" Click="Review_Click"/></StackPanel></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width=".95*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource MinecraftPanel}" Padding="22"><StackPanel><TextBlock x:Name="EndpointTitleText" Text="01 / PRISM PROFILES" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock x:Name="EndpointSubtitleText" Text="Transfer endpoints" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource InkBrush}" Margin="0,5,0,17"/><TextBlock x:Name="SourceSelectorLabel" Text="SOURCE PROFILE" Style="{StaticResource SectionLabel}"/><Grid x:Name="SourceProfilePicker" Margin="0,7,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="SourceProfileBox" SelectionChanged="Profile_SelectionChanged"/><Button Grid.Column="1" Content="BROWSE" Click="BrowseSource_Click"/></Grid><Grid x:Name="ServerSourcePicker" Margin="0,7,0,3" Visibility="Collapsed"><Button Content="BROWSE SOURCE FOLDER" Click="BrowseSource_Click"/></Grid><TextBox x:Name="SourceBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/><TextBlock x:Name="TargetSelectorLabel" Text="TARGET PROFILE" Style="{StaticResource SectionLabel}"/><Grid x:Name="TargetProfilePicker" Margin="0,7,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="TargetProfileBox" SelectionChanged="Profile_SelectionChanged"/><Button Grid.Column="1" Content="BROWSE" Click="BrowseTarget_Click"/></Grid><Grid x:Name="ServerTargetPicker" Margin="0,7,0,3" Visibility="Collapsed"><Button Content="BROWSE TARGET FOLDER" Click="BrowseTarget_Click"/></Grid><TextBox x:Name="TargetBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/><Border Style="{StaticResource MinecraftPanel}" Background="{StaticResource PanelRaisedBrush}" Padding="12"><TextBlock x:Name="EndpointHintText" Text="Profiles are discovered locally. Prism Launcher configuration is never modified." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/></Border></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource MinecraftPanel}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="02 / TRANSFER MANIFEST" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Review before execution" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource InkBrush}" Margin="0,5,0,12"/><ListBox x:Name="ItemsList" Grid.Row="2"/><StackPanel Grid.Row="3" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ChangesSummaryText" Text="Scan the whitelist to detect common tweaks and mod changes." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="ReviewChangesButton" Grid.Column="1" Content="REVIEW COMMON CHANGES" IsEnabled="False" Click="ReviewChanges_Click"/></Grid><TextBlock x:Name="WarningText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,12,0,0"/><ProgressBar x:Name="Progress" Height="8" Margin="0,10,0,0" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Ready. Choose source and target profiles." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,8,0,0"/></StackPanel></Grid></Border></Grid>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="CancelButton" Content="CANCEL" Background="{StaticResource PanelRaisedBrush}" IsEnabled="False" Visibility="Collapsed" Click="Cancel_Click"/><Button x:Name="OpenTargetButton" Content="OPEN TARGET" Background="{StaticResource PanelRaisedBrush}" IsEnabled="False" Visibility="Collapsed" Click="OpenTarget_Click"/><Button x:Name="OpenLogButton" Content="OPEN LOG" Background="{StaticResource PanelRaisedBrush}" IsEnabled="False" Visibility="Collapsed" Click="OpenLog_Click"/><Button x:Name="MigrateButton" Content="EXECUTE MIGRATION" Background="{StaticResource SuccessBrush}" IsEnabled="False" Click="Migrate_Click"/><Button Content="EXIT" Background="{StaticResource PanelRaisedBrush}" Click="Exit_Click"/></StackPanel></Grid>
<Grid x:Name="DualContentGrid" Margin="30" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="GTNH MIGRATOR" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock Text="CLIENT + SERVER TRANSFER" FontFamily="{StaticResource DisplayFont}" FontSize="40" Foreground="{StaticResource InkBrush}"/><TextBlock Text="CLIENT AND SERVER DATA" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Grid.Column="1" Content="CHANGE MIGRATION TYPE" VerticalAlignment="Bottom" Background="{StaticResource PanelRaisedBrush}" Click="ChangeMode_Click"/></Grid>
<Grid Grid.Row="1" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Select both instance pairs, then scan both whitelists." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="REFRESH PROFILES" Click="RefreshProfiles_Click"/><Button Content="SCAN BOTH" Background="{StaticResource AccentBrush}" Click="ScanBoth_Click"/></StackPanel></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width=".95*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0">
<Border Style="{StaticResource MinecraftPanel}" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="01 / CLIENT INSTANCE" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock Text="SOURCE PROFILE" Style="{StaticResource SectionLabel}" Margin="0,10,0,0"/><Grid Margin="0,7,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DualClientSourceProfileBox" SelectionChanged="Profile_SelectionChanged"/><Button Grid.Column="1" Content="BROWSE" Click="BrowseDualClientSource_Click"/></Grid><TextBox x:Name="DualClientSourceBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><TextBlock Text="TARGET PROFILE" Style="{StaticResource SectionLabel}"/><Grid Margin="0,7,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DualClientTargetProfileBox" SelectionChanged="Profile_SelectionChanged"/><Button Grid.Column="1" Content="BROWSE" Click="BrowseDualClientTarget_Click"/></Grid><TextBox x:Name="DualClientTargetBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
<Border Style="{StaticResource MinecraftPanel}" Padding="18"><StackPanel><TextBlock Text="02 / SERVER INSTANCE" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock Text="SOURCE FOLDER" Style="{StaticResource SectionLabel}" Margin="0,10,0,0"/><Button x:Name="DualServerSourceBrowseButton" Content="BROWSE SOURCE FOLDER" Margin="0,7,0,3" Click="BrowseDualServerSource_Click"/><TextBox x:Name="DualServerSourceBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><TextBlock Text="TARGET FOLDER" Style="{StaticResource SectionLabel}"/><Button x:Name="DualServerTargetBrowseButton" Content="BROWSE TARGET FOLDER" Margin="0,7,0,3" Click="BrowseDualServerTarget_Click"/><TextBox x:Name="DualServerTargetBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
</StackPanel>
<Border Grid.Column="2" Style="{StaticResource MinecraftPanel}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="03 / TRANSFER MANIFEST" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrightBrush}" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Review before execution" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource InkBrush}" Margin="0,5,0,12"/><ListBox x:Name="DualItemsList" Grid.Row="2"/><StackPanel Grid.Row="3" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DualChangesSummaryText" Text="Scan both whitelists to detect common tweaks and mod changes." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="DualReviewClientChangesButton" Grid.Column="1" Content="CLIENT CHANGES" IsEnabled="False" Click="ReviewDualClientChanges_Click"/><Button x:Name="DualReviewServerChangesButton" Grid.Column="2" Content="SERVER CHANGES" IsEnabled="False" Click="ReviewDualServerChanges_Click"/></Grid><TextBlock x:Name="DualWarningText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,12,0,0"/><ProgressBar x:Name="DualProgress" Height="8" Margin="0,10,0,0" Visibility="Collapsed"/><TextBlock x:Name="DualStatusText" Text="Ready. Choose both instance pairs." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,8,0,0"/></StackPanel></Grid></Border></Grid>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="DualCancelButton" Content="CANCEL" Background="{StaticResource PanelRaisedBrush}" IsEnabled="False" Visibility="Collapsed" Click="Cancel_Click"/><Button x:Name="DualRetryClientButton" Content="RETRY CLIENT" Background="{StaticResource AccentBrush}" IsEnabled="False" Visibility="Collapsed" Click="RetryDualSide_Click"/><Button x:Name="DualRetryServerButton" Content="RETRY SERVER" Background="{StaticResource AccentBrush}" IsEnabled="False" Visibility="Collapsed" Click="RetryDualSide_Click"/><Button x:Name="DualOpenTargetButton" Content="OPEN TARGETS" Background="{StaticResource PanelRaisedBrush}" IsEnabled="False" Visibility="Collapsed" Click="OpenTarget_Click"/><Button x:Name="DualOpenLogButton" Content="OPEN LOG" Background="{StaticResource PanelRaisedBrush}" IsEnabled="False" Visibility="Collapsed" Click="OpenLog_Click"/><Button x:Name="DualMigrateButton" Content="EXECUTE BOTH MIGRATIONS" Background="{StaticResource SuccessBrush}" IsEnabled="False" Click="DualMigrate_Click"/><Button Content="EXIT" Background="{StaticResource PanelRaisedBrush}" Click="Exit_Click"/></StackPanel></Grid>
</Grid></Window>
