<Window x:Class="GTNHMigrator.ChangesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GTNH Migrator // Migration Options" Width="860" Height="820" MinWidth="640" MinHeight="560" Background="{StaticResource PaperBrush}" WindowStartupLocation="CenterOwner">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="0,0,0,16"><TextBlock Text="GTNH // MIGRATION OPTIONS" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}"/><TextBlock Text="Settings and Mods" FontFamily="{StaticResource DisplayFont}" FontSize="32" Foreground="{StaticResource InkBrush}"/></StackPanel>
<TextBlock Grid.Row="1" x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
<Border Grid.Row="2" Style="{StaticResource MinecraftPanel}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChangesPanel"/></ScrollViewer></Border>
<TextBlock Grid.Row="3" Text="ADDITIONAL SOURCE MODS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,8"/>
<Border Grid.Row="4" Style="{StaticResource MinecraftPanel}" Padding="10"><ListBox x:Name="ModChangesList" Background="Transparent" BorderThickness="0"/></Border>
<TextBlock Grid.Row="5" x:Name="ManualSectionTitle" Text="MANUAL CHANGES" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,8"/>
<Border Grid.Row="6" Style="{StaticResource MinecraftPanel}" Padding="10"><ListBox x:Name="ManualRemindersList" Background="Transparent" BorderThickness="0"/></Border>
<StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="SELECT ALL" Background="{StaticResource PanelRaisedBrush}" Click="SelectAll_Click"/><Button Content="CLEAR OPTIONAL" Background="{StaticResource PanelRaisedBrush}" Click="ClearSelections_Click"/><Button Content="SAVE" Background="{StaticResource AccentBrush}" Click="Apply_Click"/><Button Content="CANCEL" Background="{StaticResource PanelRaisedBrush}" Click="Cancel_Click"/></StackPanel>
</Grid></Window>
